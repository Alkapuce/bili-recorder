[Unit]
Description=Archive finalized Bili recordings to Quark

[Service]
Type=oneshot
# Replace these paths with your checkout and virtual environment.
WorkingDirectory=/path/to/bili-recorder
EnvironmentFile=-/path/to/bili-recorder/config/upload.env
ExecStart=/path/to/bili-recorder/.venv/bin/bili-recorder --config /path/to/bili-recorder/config/local.ini upload
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
