[Unit]
Description=Sync finalized Bili recordings to Quark

[Service]
Type=oneshot
WorkingDirectory=/path/to/bili-recorder
# Preserve the authorized CLI channel for the official CLI outside an agent shell.
EnvironmentFile=-/path/to/bili-recorder/config/upload.env
ExecStart=/usr/bin/python3 -B /path/to/bili-recorder/quark_upload.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
